# ==============================================================
# IndusConnect Backend Environment Configuration
# ==============================================================

# Server Environment
PORT=5000
NODE_ENV=production

# --------------------------------------------------------------
# Neon Database (PostgreSQL) Configuration
# --------------------------------------------------------------
# In Neon Console (https://console.neon.tech):
# 1. Project Dashboard -> Connection Details
# 2. Keep "Pooled connection" CHECKED for DATABASE_URL:
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require"

# 3. UNCHECK "Pooled connection" to get DIRECT_URL (required for Prisma migrations):
DIRECT_URL="postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[dbname]?sslmode=require"

# --------------------------------------------------------------
# Authentication / JWT
# --------------------------------------------------------------
# Generate a strong 32+ character secret (e.g. `openssl rand -base64 32`)
JWT_SECRET="replace-with-a-secure-random-jwt-secret-key"

# --------------------------------------------------------------
# Frontend / CORS
# --------------------------------------------------------------
# Primary Vercel production frontend URL (no trailing slash)
CLIENT_URL="https://your-app-name.vercel.app"

# Optional comma-separated origins for preview or custom domains
# ALLOWED_ORIGINS="https://preview.vercel.app,http://localhost:5173"
